{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "itzme1on"
  ],
  "license": "${mod_license}",
  "icon": "logo.png",
  "contact": {
    "homepage": "${mod_page_url}",
    "sources": "${mod_git_url}",
    "issues": "${mod_issues_url}"
  },
  "environment": "*",
  "entrypoints": {
    "main": [
      "me.itzme1on.alcocraftplus.fabric.AlcoCraftPlusFabric"
    ],
    "client": [
      "me.itzme1on.alcocraftplus.fabric.client.AlcoCraftPlusFabricClient"
    ],
    "jei_mod_plugin": [
      "me.itzme1on.alcocraftplus.core.compat.jei.JEIPlugin"
    ]
  },
  "mixins": [
    "alcocraftplus.fabric.mixins.json"
  ],
  "depends": {
    "fabric": "*",
    "minecraft": ">=${minecraft_min_version} <${minecraft_max_version}",
    "architectury": ">=${architectury_api_version}",
    "fabric-api": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "${mod_discord_url}"
      }
    }
  }
}
