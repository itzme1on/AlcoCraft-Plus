{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "itzme1on"
  ],
  "license": "${mod_license}",
  "icon": "logo.png",
  "contact": {
    "homepage": "${mod_page_url}",
    "sources": "${mod_git_url}",
    "issues": "${mod_issues_url}"
  },
  "environment": "*",
  "mixins": [
    "alcocraftplus.mixins.json"
  ],
  "entrypoints": {
    "main": [
      "me.itzme1on.alcocraftplus.fabric.AlcoCraftPlusFabric"
    ],
    "client": [
      "me.itzme1on.alcocraftplus.fabric.client.AlcoCraftPlusFabricClient"
    ],
    "rei_client": [
      "me.itzme1on.alcocraftplus.fabric.core.compat.rei.AlcoCraftREIPlugin"
    ]
  },
  "depends": {
    "fabric": "*",
    "minecraft": ">=1.21.4",
    "architectury": ">=15.0.3"
  },

  "suggests": {
    "modmenu": "13.0.3"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "${mod_discord_url}"
      }
    }
  }
}